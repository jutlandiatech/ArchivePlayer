<?xml version="1.0" encoding="utf-8"?>
<!-- R73: library data is backed up; downloaded media is not (caches are never backed up). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/" />
        <exclude domain="external" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
        <exclude domain="external" path="downloads/" />
    </device-transfer>
</data-extraction-rules>
